{
  "expo": {
    "name": "Wordbout",
    "slug": "wordbout",
    "version": "0.10.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wordbout",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wordbout.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Wordbout 需要相机权限用于拍照翻译，照片仅在设备本地识别，不会上传或保存。",
        "NSMicrophoneUsageDescription": "Wordbout 需要麦克风权限用于口语跟读与语音翻译，录音不会保存到本地。",
        "NSPhotoLibraryUsageDescription": "Wordbout 需要相册权限用于选择头像与已有照片翻译。"
      }
    },
    "android": {
      "package": "com.wordbout.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Wordbout 需要相机权限用于拍照翻译。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wordbout 需要相册权限用于选择头像或照片。"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Wordbout 需要麦克风权限用于口语跟读与语音翻译。"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
