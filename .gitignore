# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# 词库构建缓存（数据源下载）
.cache/

# 临时脚本与调试产物
.tmp/

# 工具元数据（记忆、临时文件）
.workbuddy/

# 测试产物（端到端默认导到系统临时目录，这几条兜住手工指定路径的情况）
.e2e-web/
test-results/
playwright-report/
coverage/
