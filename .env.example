# AI 大模型服务（IF-3：单词解析 / 智能评分）
#
# 用法：把本文件复制为 .env（同目录），填入自己的密钥，然后重启开发服务器（改环境变量要清缓存）：
#   cp .env.example .env
#   npx expo start -c
#
# 注意：EXPO_PUBLIC_ 前缀的值会被打进客户端包，只能放**个人开发用**的密钥，不要提交到仓库。
# 这里默认接智谱开放平台（GLM-4-Flash 有免费额度）；任何 OpenAI 兼容服务都能直接用，只改下面三行。

# 密钥（必填）。控制台：https://open.bigmodel.cn/ → API Keys
EXPO_PUBLIC_AI_API_KEY=

# 服务根地址（默认智谱；换硅基流动/DeepSeek/OpenRouter 等改这里）
EXPO_PUBLIC_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型名（默认 GLM-4-Flash，免费）
EXPO_PUBLIC_AI_MODEL=glm-4-flash
